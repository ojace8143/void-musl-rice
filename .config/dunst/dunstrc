[global]
    monitor = 0
    follow = mouse
    width = 340
    height = (0, 300)
    origin = top-right
    offset = (10, 42)
    notification_limit = 5
    progress_bar = true
    font = JetBrainsMono Nerd Font 11
    frame_width = 2
    frame_color = "#478061"
    gap_size = 6
    corner_radius = 6
    background = "#1a1a1a"
    foreground = "#c9d1cf"
    timeout = 8
    icon_position = left
    icon_theme = "Papirus-Dark"

[urgency_low]
    background = "#1a1a1a"
    foreground = "#9a9a9a"
    timeout = 5

[urgency_normal]
    background = "#1a1a1a"
    foreground = "#c9d1cf"
    timeout = 8

[urgency_critical]
    background = "#1a1a1a"
    foreground = "#ad401f"
    frame_color = "#ad401f"
    timeout = 0
