# --- OS / editor junk ---
.DS_Store
*.log
*.bak
*.bak.*
*.bak-*
*~

# --- secrets / machine-specific (never commit) ---
**/auth.json
**/credentials*
**/*.token
**/.env
**/known_hosts
**/known_hosts.old
**/id_*
**/*.key

# --- large / regenerated ---
.config/chromium/
**/node_modules/
**/__pycache__/

# --- machine-specific / generated by apps ---
.config/gtk-3.0/bookmarks
.config/gtk-4.0/bookmarks
.config/gtk-4.0/gtk.css
.config/qt6ct/qt6ct.conf.bak
.config/qt5ct/qt5ct.conf.bak
